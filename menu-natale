<script>
		
		fetch('/head.html')
  .then(res => res.text())
  .then(data => {
    const temp = document.createElement('div');
    temp.innerHTML = data;

    temp.querySelectorAll('link[rel="icon"]').forEach(link => {
      const favicon = document.createElement('link');
      favicon.rel = 'icon';
      favicon.type = link.type;
      favicon.href = link.href;
      document.head.appendChild(favicon);
    });

    document.getElementById('head-content').innerHTML = data;
  });
		
fetch('header.html')
  .then(res => res.text())
  .then(data => {
    document.getElementById('header').innerHTML = data;
